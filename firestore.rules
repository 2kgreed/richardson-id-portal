rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isValidEmployee(data) {
      return data.keys().hasOnly([
        'firstName', 'lastName', 'jobTitle', 'department',
        'employeeNumber', 'photoUrl', 'status', 'issuedAt',
        'updatedAt', 'createdBy', 'issueDate', 'expiryDate'
      ])
      && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() < 100
      && data.lastName is string && data.lastName.size() > 0 && data.lastName.size() < 100
      && data.status in ['active', 'revoked'];
    }

    match /employees/{employeeId} {
      // Anyone with the exact card link can fetch that one record — this is
      // what the QR code hits. There is no query/listing path for the
      // public, so a valid link never exposes any other employee's data.
      allow get: if true;

      // Only admins can enumerate the collection (dashboard use only).
      allow list: if isAdmin();

      // Only admins can create, edit, or revoke a card.
      allow create: if isAdmin() && isValidEmployee(request.resource.data);
      allow update: if isAdmin() && isValidEmployee(request.resource.data);
      allow delete: if isAdmin();
    }

    // Immutable audit log collection
    match /audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
